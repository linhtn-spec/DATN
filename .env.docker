# Docker deployment environment variables
# This file is used when running: docker-compose up -d --build

# Backend environment
NODE_ENV=production
SERVER_PORT=5000

# Frontend URLs for production
FRONTEND_URL=http://localhost
VITE_API_BASE_URL=http://localhost/api/
VITE_SOCKET_ENDPOINT=http://localhost
VITE_FRONTEND_URL=http://localhost
VITE_ENV=production

# MongoDB (use internal Docker network)
URL_DB=mongodb://mongo-primary:27017,mongo-secondary1:27017,mongo-secondary2:27017/?replicaSet=rs0

# JWT Secrets - CHANGE THESE FOR PRODUCTION!
ACCESS_TOKEN_SECRET=your-access-token-secret-key-change-this
ACCESS_TOKEN_LIFE=24h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-key-change-this
REFRESH_TOKEN_LIFE=7d
SESSION_SECRET=your-session-secret-change-this

# CORS whitelist
WHITE_URL_1=http://localhost
WHITE_URL_2=http://localhost:80

# Elasticsearch
ELASTICSEARCH_HOST=http://es-container:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# Optional: Email configuration (leave empty to skip)
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=465
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=

# Optional: Cloudinary (leave empty to skip)
CLOUDINARY_NAME=
CLOUDINARY_APIKEY=
CLOUDINARY_APISECRET=

# Optional: Payment gateways (leave empty to skip)
VNP_TMNCODE=
VNP_HASH_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: Google OAuth (leave empty to skip)
CLIENT_ID=
CLIENT_SECRET=

# Optional: Elasticsearch password
ELASTICSEARCH_PASSWORD=
