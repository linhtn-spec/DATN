# =====================================================
# SERVER CONFIGURATION
# =====================================================
SERVER_PORT=5000

# =====================================================
# FRONTEND CONFIGURATION
# =====================================================
# Base URL for frontend application (used in email links, OAuth redirects)
FRONTEND_URL=http://localhost:5173
FRONTEND_CHANGE_PASSWORD_PATH=/change-password

# =====================================================
# DATABASE CONFIGURATION (MongoDB)
# =====================================================
# MongoDB connection for local development.
# When connecting from the host to a MongoDB replica running in Docker,
# the replica set members' internal hostnames (e.g. mongo-primary) are not
# resolvable from the host. Use `directConnection=true` to avoid lookup.
URL_DB=mongodb://localhost:27017/shop?directConnection=true

# =====================================================
# JWT AUTHENTICATION
# =====================================================
# Access token secret (short-lived, httpOnly cookie)
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_change_this_in_production
ACCESS_TOKEN_LIFE=24h

# Refresh token secret (long-lived)
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_change_this_in_production
REFRESH_TOKEN_LIFE=7d

# =====================================================
# SESSION SECRET
# =====================================================
# Used for express-session to sign session cookies
SESSION_SECRET=your_session_secret_change_this_in_production

# =====================================================
# CORS WHITELIST (Frontend Origins)
# =====================================================
WHITE_URL_1=http://localhost:3000
WHITE_URL_2=http://localhost:5173

# =====================================================
# EMAIL CONFIGURATION (Nodemailer)
# =====================================================
# Using Gmail: enable "App Passwords" in Google Account settings
# Tutorial: https://support.google.com/accounts/answer/185833
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=465
NODEMAILER_EMAIL=your_email@gmail.com
NODEMAILER_PASSWORD=your_app_specific_password

# =====================================================
# CLOUDINARY (Image Upload Service)
# =====================================================
# Sign up at https://cloudinary.com
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_APIKEY=your_cloudinary_api_key
CLOUDINARY_APISECRET=your_cloudinary_api_secret
UPLOAD_PRESET=your_upload_preset_name

# =====================================================
# VNPAY PAYMENT GATEWAY
# =====================================================
# VNPay sandbox: https://sandbox.vnpayment.vn
VNP_TMNCODE=your_merchant_code
VNP_HASH_SECRET=your_hash_secret_key
VNP_URL=https://sandbox.vnpayment.vn/paygate/pay.html
# Return URL after payment (frontend URL)
VNP_RETURN_URL=http://localhost:5173/payment/return

# =====================================================
# GOOGLE OAUTH 2.0
# =====================================================
# Setup: https://console.cloud.google.com
# Create OAuth 2.0 credentials (Web Application)
CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_google_oauth_client_secret
CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# =====================================================
# ELASTICSEARCH CONFIGURATION
# =====================================================
# Docker compose runs Elasticsearch on http://localhost:9200
# For production, use proper credentials and HTTPS
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# =====================================================
# DEFAULT SEED DATA (Admin User & Category)
# =====================================================
# These values are used when running `npm run seed`
FIRST_NAME_DEFAULT=Admin
LAST_NAME_DEFAULT=User
USERNAME_DEFAULT=admin
EMAIL_DEFAULT=admin@example.com
PASSWORD_DEFAULT=Admin@123456
ROLE_DEFAULT=3
GENDER=male

# Default category created on seed
CATEGORY_NAME_DEFAULT=All
CATEGORY_DESCRIPTION_DEFAULT=All products
CATEGORY_ORDER_DEFAULT=1

# =====================================================
# ENVIRONMENT MODE
# =====================================================
# Use 'development', 'test', or 'production'
NODE_ENV=development
