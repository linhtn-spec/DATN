# =====================================================
# FRONTEND ENVIRONMENT VARIABLES
# =====================================================
# Note: Vite automatically prefixes with VITE_ for browser access
# To use these variables, access them as: import.meta.env.VITE_VARIABLE_NAME

# =====================================================
# API CONFIGURATION
# =====================================================
# Backend API base URL
VITE_API_BASE_URL=http://localhost:5000/api/

# Backend Socket.IO endpoint (for real-time chat)
VITE_SOCKET_ENDPOINT=http://localhost:5000

# =====================================================
# FRONTEND URLs (for redirects, meta tags, etc.)
# =====================================================
# Frontend base URL (used in Open Graph, canonical links, etc.)
VITE_FRONTEND_URL=http://localhost:5173

# =====================================================
# FEATURE FLAGS
# =====================================================
# Enable/disable features in frontend (optional)
VITE_ENABLE_CHAT=true
VITE_ENABLE_ANALYTICS=false

# =====================================================
# ENVIRONMENT
# =====================================================
# Can be: development, staging, production
VITE_ENV=development
